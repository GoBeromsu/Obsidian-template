# youtube-upload — Step 0 edit pipeline defaults.
# Copy to `.env` (gitignored) to change durable defaults; or override any value
# per run with the matching build_edl.py flag (e.g. --min-silence 1.5) or an
# inline env var (e.g. YT_MIN_SILENCE=1.5).
# Precedence: CLI flag > shell-exported YT_* > this .env > built-in default
# (a YT_* already exported in your shell shadows the same line here).
# This file holds CONFIG ONLY — never OAuth tokens or API keys (those live in the
# upload credential path documented in SKILL.md First-time setup).

# --- Dead-air (silence) cut ---
YT_MIN_SILENCE=1.2     # only cut silences at least this long (seconds)
YT_CUT_PAD=0.28        # breathing room kept each side of speech (higher = looser)
YT_MERGE_GAP=0.55      # merge two keeps if the removed gap between them < this
YT_MIN_KEEP=0.30       # drop kept slivers shorter than this

# --- Repeated-stammer / false-start cut (needs word-timestamp ASR) ---
YT_STAMMER_GAP=1.0     # max gap between repeats to count as one stammer run
YT_STAMMER_MIN=2       # >= this many same-token hits triggers a cut
YT_STAMMER_MINCUT=0.15 # skip stammer removals shorter than this (micro-jumps)

# --- Energy snap (keeps splices off mid-syllable) ---
YT_SNAP_WIN=0.20       # search half-window for the local energy minimum (seconds)
YT_SNAP_FRAME=0.010    # energy hop (seconds)

# --- Color (HLG HDR -> SDR Rec.709 tonemap) ---
YT_COLOR_LOOK=hable    # tonemap operator: hable (neutral) | mobius | reinhard
YT_TONEMAP_NPL=100     # display peak luminance for the linear-light stage

# --- High-quality render ---
YT_CRF=16              # libx264 quality (lower = higher quality / bigger file)
YT_PRESET=slow         # libx264 speed/efficiency tradeoff
YT_DITHER=error_diffusion  # zscale dithering — prevents banding in tonemapped gradients
YT_ABR=256k            # AAC audio bitrate
