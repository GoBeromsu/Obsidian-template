# Local state and credentials
.DS_Store
.trash/
.env
.env.*
*.log
*.bak
.gjc/
.codex/
.omc/
.oms/
node_modules/

# Ship the vendored Agent Skills, but no local agent state.
# The directories are un-excluded first: git never descends into an excluded
# directory, so an allow-list under one is unreachable. This also overrides a
# global core.excludesFile that ignores .agents/ or .claude/ machine-wide.
!.agents/
.agents/*
!.agents/skills/
!.claude/
.claude/*
!.claude/skills/

# Ship only the reviewed portable Obsidian settings and snippets.
.obsidian/*
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
!.obsidian/daily-notes.json
!.obsidian/hotkeys.json
!.obsidian/plugins/
.obsidian/plugins/*
!.obsidian/plugins/templater-obsidian/
!.obsidian/plugins/obsidian-excalidraw-plugin/
!.obsidian/plugins/homepage/
!.obsidian/plugins/omnisearch/
!.obsidian/plugins/obsidian-outliner/
!.obsidian/plugins/obsidian-linter/
.obsidian/plugins/*/*
!.obsidian/plugins/*/main.js
!.obsidian/plugins/*/manifest.json
!.obsidian/plugins/*/styles.css
!.obsidian/plugins/templater-obsidian/data.json
!.obsidian/plugins/obsidian-excalidraw-plugin/data.json
!.obsidian/plugins/homepage/data.json
!.obsidian/snippets/
.obsidian/snippets/*
!.obsidian/snippets/fix-nested-bullets.css
!.obsidian/snippets/mermaid-wide.css
